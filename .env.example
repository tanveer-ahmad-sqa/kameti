# Copy to .env.local for local development (never commit .env.local).
# EXPO_PUBLIC_* values are bundled into the app and are NOT secret.
# For EAS builds, set these as EAS environment variables per environment
# (development / preview / production) instead of using a .env file.

# --- App (public) -----------------------------------------------------------
# Local: printed by `npm run db:start` (API URL and Publishable key).
# Use your machine's LAN IP instead of 127.0.0.1 when testing on a physical device.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Sentry DSN (optional locally; errors are only reported when set).
EXPO_PUBLIC_SENTRY_DSN=

# --- Build-time only (EAS secrets, not bundled) -------------------------------
# Sentry source map upload during EAS builds.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Set after `npx eas-cli@latest init`.
EAS_PROJECT_ID=
